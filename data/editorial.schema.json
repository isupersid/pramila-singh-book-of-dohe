{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://isupersid.github.io/pramila-singh-book-of-dohe/data/editorial.schema.json",
  "title": "Man Ke Moti editorial drafts",
  "type": "object",
  "required": ["schemaVersion", "status", "notice", "records"],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "status": {
      "const": "draft"
    },
    "notice": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "confidence": {
      "enum": ["low", "medium", "high"]
    },
    "record": {
      "type": "object",
      "required": [
        "noteId",
        "status",
        "review",
        "source",
        "romanTransliteration",
        "literalEnglish",
        "childFriendlyEnglish",
        "simpleHindiExplanation",
        "context",
        "flags"
      ],
      "properties": {
        "noteId": {
          "type": "string",
          "pattern": "^notes_[0-9]+$"
        },
        "status": {
          "const": "draft"
        },
        "review": {
          "type": "object",
          "required": ["familyReviewed", "reviewedBy", "reviewedAt"],
          "properties": {
            "familyReviewed": {
              "const": false
            },
            "reviewedBy": {
              "type": "null"
            },
            "reviewedAt": {
              "type": "null"
            }
          },
          "additionalProperties": false
        },
        "source": {
          "type": "object",
          "required": ["path", "date", "prompt", "sha256"],
          "properties": {
            "path": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "prompt": {
              "type": ["string", "null"]
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        "romanTransliteration": {
          "$ref": "#/$defs/lineLayer"
        },
        "literalEnglish": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/translationLayer"
            }
          ]
        },
        "childFriendlyEnglish": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/textLayer"
            }
          ]
        },
        "simpleHindiExplanation": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/textLayer"
            }
          ]
        },
        "context": {
          "type": "object",
          "required": ["text", "theme", "confidence", "evidence", "editorialNote"],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "theme": {
              "type": "string",
              "minLength": 1
            },
            "confidence": {
              "$ref": "#/$defs/confidence"
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["type", "value", "source"]
              }
            },
            "editorialNote": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "flags": {
          "type": "array",
          "contains": {
            "const": "family-review-required"
          },
          "items": {
            "type": "string"
          }
        }
      }
    },
    "lineLayer": {
      "type": "object",
      "required": ["lines", "method", "confidence"],
      "properties": {
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "translationLayer": {
          "type": "object",
          "required": ["lines", "method", "confidence", "editorialNote"],
          "properties": {
            "lines": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "method": {
              "const": "curated-draft"
            },
            "confidence": {
              "$ref": "#/$defs/confidence"
            },
            "editorialNote": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "textLayer": {
      "type": "object",
      "required": ["text", "confidence", "editorialNote"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "editorialNote": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
